<mvc:View
  controllerName="project1.controller.Product"
  xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.uxap"
	xmlns:m="sap.m"
  xmlns:f="sap.ui.layout.form">
  <ObjectPageLayout id="ObjectPageLayout" >

    <headerTitle>
      <ObjectPageHeader objectTitle="{odatav2>Name}" />
		</headerTitle>
  
      <sections>
        <ObjectPageSection title="{i18n>productInformation}">
          <subSections>
            <ObjectPageSubSection>
              <blocks>
                <f:SimpleForm layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="3">
                  <m:Label text="{i18n>productId}" />
                  <m:Text text="{odatav2>ID}" />

                  <m:Label text="{i18n>productName}" />
                  <m:Text text="{odatav2>Name}" />

                  <m:Label text="{i18n>productDescription}" />
                  <m:Text text="{odatav2>Description}" />

                  <m:Label text="{i18n>productReleaseDate}" />
                  <m:Text text="{path: 'odatav2>ReleaseDate', type: 'sap.ui.model.type.Date'}" />

                  <m:Label text="{i18n>productDiscontinuedDate}" />
                  <m:Text text="{path: 'odatav2>DiscontinuedDate', type: 'sap.ui.model.type.Date'}" />

                  <m:Label text="{i18n>productRating}" />
                  <m:Text text="{odatav2>Rating}" />

                  <m:Label text="{i18n>productPrice}" />
                  <m:Text text="{odatav2>Price}" />
                </f:SimpleForm>
              </blocks>
            </ObjectPageSubSection>
          </subSections>
        </ObjectPageSection>

        <ObjectPageSection title="{i18n>supplierInformation}">
          <subSections>
            <ObjectPageSubSection title="{i18n>supplier}">
              <blocks>
                <f:SimpleForm layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="3">
                    <m:Label text="{i18n>supplierId}" />
                    <m:Text text="{odatav2>Supplier/ID}" /> 

                    <m:Label text="{i18n>supplierName}" />
                    <m:Text text="{odatav2>Supplier/Name}" /> 

                    <m:Label text="{i18n>supplierConcurrency}" />
                    <m:Text text="{odatav2>Supplier/Concurrency}" /> 
                </f:SimpleForm>
              </blocks>
            </ObjectPageSubSection>

            <ObjectPageSubSection title="{i18n>supplierAddress}" >
              <blocks>
                <f:SimpleForm layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="3">
                    <m:Label text="{i18n>supplierStreet}" />
                    <m:Text text="{odatav2>Supplier/Address/Street}" /> 

                    <m:Label text="{i18n>supplierCity}" />
                    <m:Text text="{odatav2>Supplier/Address/City}" /> 

                    <m:Label text="{i18n>supplierState}" />
                    <m:Text text="{odatav2>Supplier/Address/State}" /> 

                    <m:Label text="{i18n>supplierZipCode}" />
                    <m:Text text="{odatav2>Supplier/Address/ZipCode}" /> 

                    <m:Label text="{i18n>supplierCountry}" />
                    <m:Text text="{odatav2>Supplier/Address/Country}" /> 
                </f:SimpleForm>
              </blocks>
            </ObjectPageSubSection>

          </subSections>
        </ObjectPageSection>
      </sections>
  </ObjectPageLayout>
</mvc:View>