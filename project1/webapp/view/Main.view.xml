<mvc:View controllerName="project1.controller.Main"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="Books">
        <Table id="booksTable" items="{books>/books}" mode="MultiSelect">
            <headerToolbar>
                <Toolbar >
                    <Button text="{i18n>addRecord}" press=".onAddRecord" />
                    <Button text="{i18n>deleteRecord}" press=".onDeleteRecord" />
                    <ToolbarSeparator />
                    <Input 
                      id="filterInput" 
                      placeholder="{i18n>nameFilter}" 
                      width="12rem" 
                      value="{books>/filter/query}" 
                      />
                    <Select
                        id="genreFilter"
                        selectedKey="{books>/filter/genre}"
                        items="{books>/genres}">

                        <core:Item
                            key="{books>key}"
                            text="{books>name}" />

                    </Select>
                    <Button text="{i18n>filter}" type="Emphasized" press=".onFilter"></Button>
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column><Text text="ID" /></Column>
                <Column><Text text="Name" /></Column>
                <Column><Text text="Author" /></Column>
                <Column><Text text="Genre" /></Column>
                <Column><Text text="Release Date" /></Column>
                <Column hAlign="End"><Text text="Available" /></Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{books>ID}" />
                        <Text text="{books>Name}" />
                        <Text text="{books>Author}" />
                        <Text text="{books>Genre}" />
                        <Text text="{
                            path: 'books>ReleaseDate',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: {
                                source: { pattern: 'yyyy-MM-dd' },
                                pattern: 'dd.MM.yyyy'
                            }
                        }" />
                        <ObjectNumber number="{books>AvailableQuantity}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>