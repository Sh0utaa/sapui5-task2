<mvc:View
    controllerName="project1.controller.Products"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m" >
    <Table id="odatav2-table" mode="MultiSelect" items="{odatav2>/Products}" >
        <headerToolbar>
            <Toolbar >
                <Button text="{i18n>productDelete}" type="Emphasized" press=".onDeleteProduct"  />
            </Toolbar>
        </headerToolbar>
        <columns>
            <Column><Text text="{i18n>productId}" /></Column>
            <Column><Text text="{i18n>productName}" /></Column>
            <Column><Text text="{i18n>productDescription}" /></Column>
            <Column><Text text="{i18n>productReleaseDate}" /></Column>
            <Column><Text text="{i18n>productDiscontinuedDate}" /></Column>
            <Column><Text text="{i18n>productRating}" /></Column>
            <Column><Text text="{i18n>productPrice}" /></Column>
        </columns>
        <items>
            <ColumnListItem >
                <cells>
                <Text text="{odatav2>ID}" />
                <Text text="{odatav2>Name}" />
                <Text text="{odatav2>Description}" />
                <Text text="{path: 'odatav2>ReleaseDate', type: 'sap.ui.model.type.Date'}" />
                <Text text="{path: 'odatav2>DiscontinuedDate', type: 'sap.ui.model.type.Date'}" />
                <Text text="{odatav2>Rating}" />
                <Text text="{odatav2>Price}" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</mvc:View>