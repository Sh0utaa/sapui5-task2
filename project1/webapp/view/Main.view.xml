<mvc:View controllerName="project1.controller.Main"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    >
    <Page title="{i18n>pageTitle}">
        <IconTabBar
            id="idIconTabBarNoIcons"
            class="sapUiResponsiveContentPadding">
            <items>
                <IconTabFilter text="JSON Model" key="json-model">
                <Table id="booksTable" items="{books>/books}" mode="MultiSelect" selectionChange=".onSelectionChange" >
                    <headerToolbar>
                        <Toolbar >
                            <Button text="{i18n>addRecord}" press=".onAddRecordDialogPress" />
                            <Button text="{i18n>deleteRecord}" 
                                press=".onConfirmationMessageBoxPress" 
                                enabled="{books>/document/hasSelected}" />
                            <ToolbarSeparator />
                            <Input
                                id="filterInput"
                                placeholder="{i18n>nameFilter}"
                                width="12rem"
                                value="{books>/filter/query}"
                                liveChange=".onFilterChange"
                            />
                            <Select
                                id="genreFilter"
                                selectedKey="{books>/filter/genre}"
                                items="{books>/genres}">
                                <core:Item key="{books>key}" text="{books>name}" />
                            </Select>
                            <Button text="{i18n>filter}" type="Emphasized" press=".onFilter"></Button>
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="{i18n>columnId}" /></Column>
                        <Column><Text text="{i18n>columnName}" /></Column>
                        <Column><Text text="{i18n>columnActions}" ></Text></Column>
                        <Column><Text text="{i18n>columnAuthor}" /></Column>
                        <Column><Text text="{i18n>columnGenre}" /></Column>
                        <Column><Text text="{i18n>columnReleaseDate}" /></Column>
                        <Column hAlign="End"><Text text="{i18n>columnAvailable}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{books>ID}" />

                                <HBox>
                                    <Text visible="{= !${books>editMode}}" text="{books>Name}" />
                                    <Input visible="{= ${books>editMode} === true}" value="{books>Name}" />
                                </HBox >

                                <Button text="{= !${books>editMode} ? 'Edit Title' : 'Save' }" 
                                    press=".onEditTitle" 
                                ></Button>

                                <Text text="{books>Author}" />
                                <Text text="{books>Genre}" />
                                
                                <Text text="{
                                    path: 'books>ReleaseDate',
                                    type: 'sap.ui.model.type.String',
                                    formatter: '.formatter.displayPublishedYear'
                                }" />
                                <ObjectNumber number="{books>AvailableQuantity}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                </IconTabFilter >
                <IconTabFilter text="OData Version 2.0" >
                    <Table id="odatav2-table" mode="MultiSelect" items="{odatav2>/Products}" >
                        <headerToolbar>
                            <Toolbar >
                                <Button text="{i18n>productDelete}" type="Emphasized" press=".onDeleteProduct"  />
                            </Toolbar>
                        </headerToolbar>
                        <columns>
                            <Column><Text text="{i18n>productId}" /></Column>
                            <Column><Text text="{i18n>productName}" /></Column>
                            <Column><Text text="{i18n>productDescription}" /></Column>
                            <Column><Text text="{i18n>productReleaseDate}" /></Column>
                            <Column><Text text="{i18n>productDiscontinuedDate}" /></Column>
                            <Column><Text text="{i18n>productRating}" /></Column>
                            <Column><Text text="{i18n>productPrice}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem >
                                <cells>
                                <Text text="{odatav2>ID}" />
                                <Text text="{odatav2>Name}" />
                                <Text text="{odatav2>Description}" />
                                <Text text="{path: 'odatav2>ReleaseDate', type: 'sap.ui.model.type.Date'}" />
                                <Text text="{path: 'odatav2>DiscontinuedDate', type: 'sap.ui.model.type.Date'}" />
                                <Text text="{odatav2>Rating}" />
                                <Text text="{odatav2>Price}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </IconTabFilter >
                <IconTabFilter text="OData Version 4.0" >
                    <Table id="odatav4-table" mode="MultiSelect" items="{odatav4>/Products}" >
                        <columns>
                            <Column><Text text="{i18n>productId}" /></Column>
                            <Column><Text text="{i18n>productName}" /></Column>
                            <Column><Text text="{i18n>productDescription}" /></Column>
                            <Column><Text text="{i18n>productReleaseDate}" /></Column>
                            <Column><Text text="{i18n>productDiscontinuedDate}" /></Column>
                            <Column><Text text="{i18n>productRating}" /></Column>
                            <Column><Text text="{i18n>productPrice}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem >
                                <cells>
                                    <Text text="{odatav4>ID}" />
                                    <Text text="{odatav4>Name}" />
                                    <Text text="{odatav4>Description}" />
                                    <Text text="{path: 'odatav4>ReleaseDate', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: {precision: 3}}" />
                                    <Text text="{path: 'odatav4>DiscontinuedDate', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: {precision: 3}}" />
                                    <Text text="{odatav4>Rating}" />
                                    <Text text="{odatav4>Price}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </IconTabFilter >
            </items>
        </IconTabBar>
    </Page>
</mvc:View>